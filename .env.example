# Modus styrer hvilket execution-lag som brukes: backtest / paper / live.
# main.py bruker foreløpig alltid lokal paper-simulering uansett verdi her –
# reell live-execution (ekte ordre) er ikke bygget ennå.
TRADING_MODE=backtest

# Valutapar boten følger, Alpha Vantage-format (FRA_TIL)
INSTRUMENT=EUR_USD

# Market data (Alpha Vantage – gratis, kun e-post for nøkkel, ingen megler/KYC nødvendig)
ALPHA_VANTAGE_API_KEY=

# Database (PostgreSQL / TimescaleDB)
DATABASE_URL=postgresql://user:password@localhost:5432/tradingbot

# Overvåking/varsling
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Statusrapportering til GitHub (status.json på "bot-status"-grenen) – valgfritt,
# hoppes over hvis tom. Personal Access Token med kun "Contents: write" på dette
# repoet holder, trenger ikke bred kontotilgang.
GITHUB_TOKEN=
