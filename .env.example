# Modus styrer hvilket execution-lag som brukes: backtest / paper / live.
# main.py bruker foreløpig alltid lokal paper-simulering uansett verdi her –
# reell live-execution (ekte ordre) er ikke bygget ennå.
TRADING_MODE=backtest

# Valutapar boten følger, komma-separert, Alpha Vantage-format (FRA_TIL). Hver
# strategi kjøres på hvert par (2 strategier x 8 par = 16 uavhengige "linjer",
# hver med sin egen kapital-andel og posisjon).
INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CAD,USD_CHF,NZD_USD,EUR_GBP

# Total startkapital (simulert), delt likt mellom alle linjer
STARTING_CASH=10000

# Hvor ofte boten sjekker for nytt signal, i sekunder. Utledes automatisk fra
# antall instrumenter (~16 kall/dag totalt, trygt under Alpha Vantage sin
# gratis-grense på ~25/dag) – sett eksplisitt her for å overstyre.
# CHECK_INTERVAL_SECONDS=43200

# Market data (Alpha Vantage – gratis, kun e-post for nøkkel, ingen megler/KYC nødvendig)
ALPHA_VANTAGE_API_KEY=

# Database (PostgreSQL / TimescaleDB)
DATABASE_URL=postgresql://user:password@localhost:5432/tradingbot

# Overvåking/varsling
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Statusrapportering til GitHub (status.json på "bot-status"-grenen) – valgfritt,
# hoppes over hvis tom. Personal Access Token med kun "Contents: write" på dette
# repoet holder, trenger ikke bred kontotilgang.
GITHUB_TOKEN=
